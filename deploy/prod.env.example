# Secrets and settings for deploy/compose.prod.yml. Copy it out of the checkout
# (`cp deploy/prod.env.example prod.env`), fill in every value, keep it private,
# and pass it with `--env-file prod.env`.

# The release to run: ghcr.io/tekeburak/scion-server:<SCION_VERSION>.
SCION_VERSION=
# The one address clients use: https://<SCION_DOMAIN>.
SCION_DOMAIN=

# The metadata database's password; letters and digits only, since it goes
# into a URL (`openssl rand -hex 24`).
POSTGRES_PASSWORD=

# Signs and checks tokens (`openssl rand -hex 32`). Changing it signs everyone out.
SCION_TOKEN_KEY=

# The S3 bucket objects are stored in. It must exist; the server never creates it.
# AWS: AWS_ENDPOINT=https://s3.<region>.amazonaws.com. Other S3-compatible
# services give their own endpoint. AWS_ALLOW_HTTP=true only for a plain-http one.
AWS_ENDPOINT=
AWS_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ALLOW_HTTP=false

# A GitHub OAuth app with device flow enabled, for `scn login` and browser
# sign-in; its callback URL is https://<SCION_DOMAIN>/login/callback. Left empty,
# only `scion-server token` tokens work and the pages show public repositories.
SCION_GITHUB_CLIENT_ID=
SCION_GITHUB_CLIENT_SECRET=
