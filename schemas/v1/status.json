{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tekeburak/scion/schemas/v1/status.json",
  "title": "scn status --json",
  "description": "Files that differ from the checked-out head, by path.",
  "type": "object",
  "properties": {
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "$ref": "defs.json#/$defs/path"
          },
          "status": {
            "enum": [
              "modified",
              "deleted",
              "added",
              "untracked"
            ]
          }
        },
        "required": [
          "path",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "files"
  ],
  "additionalProperties": false
}
