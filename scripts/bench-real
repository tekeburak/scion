#!/usr/bin/env bash
# Scion against git on a pinned slice of a real repository.
#
#   scripts/bench-real [runs=3] [out=target/bench-real/results.csv]
#
# Needs git, protoc, openssl, Docker (with compose) and the Rust toolchain pinned
# by rust-toolchain.toml. It starts deploy/docker-compose.yml, builds the release
# binaries, runs scion-server on loopback over Postgres + S3, and leaves the
# stack running (reset it with `docker compose -f deploy/docker-compose.yml down -v`).
#
# Two other public implementations of the same reference design run the same
# workloads on the same slice when their clone URLs are given (see "Performance
# bar" in docs/ARCHITECTURE.md):
#
#   BENCH_IMPL_A_URL=<git url> BENCH_IMPL_B_URL=<git url> scripts/bench-real
#
# Each is pinned to the commit in IMPL_*_COMMIT below, fetched and built once
# under target/bench-real/, and refused if the URL does not serve that commit.
# impl-a runs over CockroachDB (a container this script starts and removes) and
# the same S3 server as Scion, one fresh bucket and repository per run, over
# TLS with a throwaway CA. impl-b keeps its state in memory, so its server is
# restarted per run. A workload one of them cannot express is printed and
# recorded as `unsupported`.
#
# The slice is the `library/` directory of rust-lang/rust over its first-parent
# history from SINCE to TIP: every first-parent commit that touched it becomes
# one linear commit whose tree is that directory, with author, committer, dates
# and message kept and submodule entries dropped. It is built once and cached
# under target/bench-real/. Git and Scion then start from that same repository.
#
# Each run uses a fresh bare git repository and a fresh Scion repository name,
# so every Scion run is cold (derived data included). Workloads:
#
#   import       git: push the history into an empty bare repository;
#                scn: scion-ingest import
#   clone        git clone --no-local; scn clone
#   sparse clone git clone --filter=blob:none --sparse + sparse-checkout set;
#                scn clone --sparse
#   status       clean working copy: git status; scn status
#   log          first-parent history of one directory: git log; scn log
#   blame        one file at the tip: git blame; scn blame
#   land         edit one file, commit it and publish it: git commit -a + push;
#                scn commit + land
#
# git runs its history workloads (status, log, blame, land) in the full clone,
# its best case; scn and the other implementations run them in the sparse
# clone, their normal case. Checkouts
# are compared byte for byte outside the timers. Each sample is one CSV row
# (`workload,tool,run,ms,result`, result `ok`, `failed` or `unsupported`); the `#` lines at
# the top record the repository, commit range and machine.

set -euo pipefail

UPSTREAM=https://github.com/rust-lang/rust.git
TIP=91e9c2688eb23af9a5b77f056156e756550c7c99
SINCE=2026-01-01
SUBDIR=library
SPARSE=core
LOG_PATH=core/src
BLAME_FILE=alloc/src/vec/mod.rs
EDIT_FILE=core/src/lib.rs
IMPL_A_COMMIT=7d445a0744e30f4dcb36a794b0ce42648157e1b9
IMPL_B_COMMIT=00e92ab9c2a9985f39a64636b4b6c5c4bb583916
IMPL_A_URL=${BENCH_IMPL_A_URL:-}
IMPL_B_URL=${BENCH_IMPL_B_URL:-}
CRDB_IMAGE=cockroachdb/cockroach:v24.3.5
CRDB=scion-bench-crdb

RUNS=${1:-3}
ROOT=$(cd "$(dirname "$0")/.." && pwd)
WORK=$ROOT/target/bench-real
OUT=${2:-$WORK/results.csv}
SUBSET=$WORK/subset-${TIP:0:12}.git
BIN=$ROOT/target/release
COMPOSE=(docker compose -f "$ROOT/deploy/docker-compose.yml")

export DATABASE_URL=postgres://scion:scion@127.0.0.1:5432/scion
export AWS_ENDPOINT=http://127.0.0.1:9000 AWS_ALLOW_HTTP=true AWS_BUCKET=scion-objects
export AWS_ACCESS_KEY_ID=scion AWS_SECRET_ACCESS_KEY=scionscion AWS_REGION=us-east-1
export SCN_AUTHOR="Bench <bench@example.com>"
# Hermetic git: no user or system config, fixed identity.
export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null
export GIT_AUTHOR_NAME=Bench GIT_AUTHOR_EMAIL=bench@example.com
export GIT_COMMITTER_NAME=Bench GIT_COMMITTER_EMAIL=bench@example.com
export GIT_CONFIG_COUNT=2 GIT_CONFIG_KEY_0=gc.auto GIT_CONFIG_VALUE_0=0
export GIT_CONFIG_KEY_1=init.defaultBranch GIT_CONFIG_VALUE_1=main

say() { echo "bench-real: $*" >&2; }

# Builds $SUBSET: fetch the range without blobs, rewrite it, then fetch only
# the blobs the rewritten history needs.
build_subset() {
    local up=$WORK/upstream.git
    rm -rf "$up" "$SUBSET.tmp"
    git init -q --bare "$up"
    git -C "$up" remote add origin "$UPSTREAM"
    say "fetching $UPSTREAM $TIP since $SINCE (no blobs)"
    git -C "$up" fetch -q --filter=blob:none --shallow-since="$SINCE" --no-tags origin "$TIP"

    say "rewriting the first-parent history of $SUBDIR/"
    local index=$WORK/subset.index parent="" commit tree n=0
    # A field separator that cannot appear in names, emails or dates.
    local fmt=$'%H\x1f%an\x1f%ae\x1f%ad\x1f%cn\x1f%ce\x1f%cd'
    while IFS=$'\x1f' read -r commit an ae ad cn ce cd; do
        rm -f "$index"
        GIT_INDEX_FILE=$index git -C "$up" read-tree "$commit:$SUBDIR"
        GIT_INDEX_FILE=$index git -C "$up" ls-files -s |
            awk -F'\t' '$1 ~ /^160000 / { print "0 0000000000000000000000000000000000000000\t" $2 }' |
            GIT_INDEX_FILE=$index git -C "$up" update-index --index-info
        tree=$(GIT_INDEX_FILE=$index git -C "$up" write-tree)
        parent=$(git -C "$up" log -1 --format=%B "$commit" |
            GIT_AUTHOR_NAME=$an GIT_AUTHOR_EMAIL=$ae GIT_AUTHOR_DATE=$ad \
            GIT_COMMITTER_NAME=$cn GIT_COMMITTER_EMAIL=$ce GIT_COMMITTER_DATE=$cd \
            git -C "$up" commit-tree "$tree" ${parent:+-p "$parent"})
        n=$((n + 1))
    done < <(git -C "$up" log --first-parent --reverse --date=raw --format="$fmt" "$TIP" -- "$SUBDIR")
    rm -f "$index"

    say "fetching the blobs of $n commits"
    git -C "$up" rev-list --objects --missing=print "$parent" | sed -n 's/^?//p' |
        git -C "$up" -c fetch.negotiationAlgorithm=noop fetch -q --no-tags \
            --no-write-fetch-head --filter=blob:none --stdin origin

    git init -q --bare "$SUBSET.tmp"
    git -C "$up" push -q "$SUBSET.tmp" "$parent:refs/heads/main"
    mv "$SUBSET.tmp" "$SUBSET"
    rm -rf "$up"
}

# Milliseconds `"$@"` takes, appended to the CSV as one sample. A workload
# that fails is recorded as failed and the run goes on, so one slow RPC does
# not hide the other numbers.
time_it() {
    local workload=$1 tool=$2 run=$3 start end result=ok
    shift 3
    start=$(now_ms)
    if ! "$@" >/dev/null 2>"$WORK/stderr"; then
        result=failed
        say "$workload ($tool) failed: $(tail -1 "$WORK/stderr")"
    fi
    end=$(now_ms)
    echo "$workload,$tool,$run,$((end - start)),$result" >>"$OUT"
}

# BSD date has no %N; perl ships with macOS.
if [ "$(date +%N)" = N ]; then
    now_ms() { perl -MTime::HiRes=time -e 'printf "%d\n", time * 1000'; }
else
    now_ms() { echo $(($(date +%s%N) / 1000000)); }
fi

# Fails unless the git checkout $1 and the checkout $2, whose metadata
# directory is $3 (default .scn), hold the same paths, contents and modes.
same_checkout() {
    local meta=${3:-.scn}
    diff -r -x .git -x "$meta" "$1" "$2" >/dev/null ||
        { say "checkouts differ: $1 $2"; return 1; }
    [ "$(cd "$1" && find . -path ./.git -prune -o -type f -perm -u+x -print | sort)" = \
      "$(cd "$2" && find . -path "./$meta" -prune -o -type f -perm -u+x -print | sort)" ] ||
        { say "file modes differ: $1 $2"; return 1; }
}

unsupported() {
    say "$1 ($2): cannot be expressed, recorded as unsupported"
    echo "$1,$2,$3,,unsupported" >>"$OUT"
}

# Fetches $1 at exactly commit $2 into $3 and builds its release binaries with
# its own pinned toolchain.
build_impl() {
    local url=$1 commit=$2 dir=$3
    if [ ! -f "$dir/.built" ]; then
        rm -rf "$dir"
        git init -q "$dir"
        say "fetching $commit"
        git -C "$dir" fetch -q --depth 1 "$url" "$commit"
        git -C "$dir" checkout -q FETCH_HEAD
        say "building $(basename "$dir")"
        (cd "$dir" && cargo build -q --release --workspace --bins)
        touch "$dir/.built"
    fi
    [ "$(git -C "$dir" rev-parse HEAD)" = "$commit" ] ||
        { say "$dir is not at the pinned commit $commit"; exit 1; }
}

# Waits until "$2" succeeds, giving up after about 20 s or when pid $1 exits.
wait_for() {
    local pid=$1
    shift
    for _ in $(seq 1 100); do
        "$@" >/dev/null 2>&1 && return 0
        kill -0 "$pid" 2>/dev/null || return 1
        sleep 0.2
    done
    return 1
}

# impl-a's backends and credentials, shared by every run: a CockroachDB
# container, a CA with a loopback server certificate, a token signing key, a
# service principal and an access policy that lets it read, write and land.
# Its importer replaces the repository's bootstrap root changeset on main with
# a forced update, hence `force`.
setup_impl_a() {
    local d=$WORK/impl-a-env
    rm -rf "$d"
    mkdir -p "$d"
    docker rm -f "$CRDB" >/dev/null 2>&1 || true
    docker run -d -q --name "$CRDB" -p 127.0.0.1:26257:26257 "$CRDB_IMAGE" \
        start-single-node --insecure >/dev/null
    for _ in $(seq 1 100); do
        docker exec "$CRDB" cockroach sql --insecure -e 'SELECT 1' >/dev/null 2>&1 && break
        sleep 0.3
    done
    openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 2 \
        -subj /CN=bench-ca -keyout "$d/ca.key" -out "$d/ca.pem" 2>/dev/null
    openssl req -new -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes \
        -subj /CN=127.0.0.1 -keyout "$d/tls.key" -out "$d/tls.csr" 2>/dev/null
    printf 'subjectAltName=IP:127.0.0.1\nbasicConstraints=CA:FALSE\n' >"$d/ext"
    openssl x509 -req -in "$d/tls.csr" -CA "$d/ca.pem" -CAkey "$d/ca.key" -CAcreateserial \
        -days 2 -extfile "$d/ext" -out "$d/tls.crt" 2>/dev/null
    openssl genpkey -algorithm ed25519 -out "$d/signing.pem" 2>/dev/null
    cat >"$d/acl.toml" <<'ACL'
version = 1

[groups]
bench = ["service:bench"]

[[paths]]
prefix = "/"
read = ["group:bench"]
write = ["group:bench"]

[refs."main"]
update = ["group:bench"]
force = ["group:bench"]

[admin]
refs = ["group:bench"]
ACL
}

# Starts impl-a's server for repository $1 on a fresh bucket $1 and exports
# the endpoint and a token for its clients.
start_impl_a() {
    local d=$WORK/impl-a-env name=$1 port=$(( (RANDOM % 20000) + 30000 ))
    "${COMPOSE[@]}" run --rm --no-deps --entrypoint aws bucket-init \
        --endpoint-url http://rustfs:9000 s3 mb "s3://$name" >/dev/null
    cat >"$d/server.toml" <<TOML
[server]
listen = "127.0.0.1:$port"
tls_cert = "$d/tls.crt"
tls_key = "$d/tls.key"
repo = "$name"

[metadata]
url = "postgresql://root@127.0.0.1:26257/defaultdb?sslmode=disable"

[objects]
endpoint = "$AWS_ENDPOINT"
bucket = "$name"
region = "$AWS_REGION"

[auth]
github_client_id = "bench"
signing_keys = ["$d/signing.pem"]

[[auth.service_principals]]
name = "bench"
secret_sha256 = "$(printf bench | openssl dgst -sha256 -r | cut -d' ' -f1)"

[policy]
path = "$d/acl.toml"

[observability]
log_format = "text"
metrics_listen = "127.0.0.1:$((port + 1))"
TOML
    "$IMPL_A/target/release/scion-server" --config "$d/server.toml" >"$d/server.log" 2>&1 &
    impl_a_pid=$!
    export SCION_ENDPOINT=https://127.0.0.1:$port SCION_CA_FILE=$d/ca.pem SCION_AUTHOR=$SCN_AUTHOR
    unset SCION_TOKEN
    wait_for "$impl_a_pid" env HOME="$d" SCION_SERVICE_SECRET=bench \
        "$IMPL_A/target/release/scion" login --service bench ||
        { cat "$d/server.log" >&2; exit 1; }
    SCION_TOKEN=$(sed -n 's/^token = "\(.*\)"$/\1/p' "$d/.config/scion/credentials")
    export SCION_TOKEN
}

impl_a_run() {
    local run=$1 dir=$2 a=$IMPL_A/target/release
    start_impl_a "bench-a-$stamp-$run"
    time_it import impl-a "$run" "$a/scion-import" --git "$SUBSET" --ref main --target-ref main
    time_it clone impl-a "$run" "$a/scion" checkout main "$dir/a-full"
    same_checkout "$dir/git-full" "$dir/a-full" .scion
    time_it "sparse clone" impl-a "$run" "$a/scion" checkout main "$dir/a-sparse" --sparse "$SPARSE"
    same_checkout "$dir/git-sparse/$SPARSE" "$dir/a-sparse/$SPARSE" .scion
    time_it status impl-a "$run" "$a/scion" -C "$dir/a-sparse" status
    time_it log impl-a "$run" "$a/scion" -C "$dir/a-sparse" log "$LOG_PATH" --rev main --first-parent --limit 1000
    time_it blame impl-a "$run" "$a/scion" -C "$dir/a-sparse" blame "$BLAME_FILE"
    echo "// bench-real run $run" >>"$dir/a-sparse/$EDIT_FILE"
    time_it land impl-a "$run" sh -c "'$a/scion' -C '$dir/a-sparse' commit -m 'bench edit' &&
        '$a/scion' -C '$dir/a-sparse' land --ref main"
    kill "$impl_a_pid" 2>/dev/null || true
    wait "$impl_a_pid" 2>/dev/null || true
}

# impl-b names its binaries after itself: the server is the one ending in
# -server, the client the one without a dash, and its working-copy metadata
# directory is the client's name with a leading dot.
impl_b_run() {
    local run=$1 dir=$2 server cli port=$(( (RANDOM % 20000) + 30000 ))
    server=$(find "$IMPL_B/target/release" -maxdepth 1 -type f -perm -u+x -name '*-server')
    cli=$(find "$IMPL_B/target/release" -maxdepth 1 -type f -perm -u+x ! -name '*-*' ! -name '*.*')
    "$server" --listen "127.0.0.1:$port" >"$WORK/impl-b-server.log" 2>&1 &
    impl_b_pid=$!
    wait_for "$impl_b_pid" curl -sf "http://127.0.0.1:$port/healthz" ||
        { cat "$WORK/impl-b-server.log" >&2; exit 1; }
    # It imports one tree as a parentless snapshot, not a history: load the
    # tip outside the timers so the other workloads have something to read.
    unsupported import impl-b "$run"
    mkdir -p "$dir/b-tip"
    git -C "$SUBSET" archive main | tar -x -C "$dir/b-tip"
    "$cli" --server "http://127.0.0.1:$port" import "$dir/b-tip" -m import >/dev/null
    time_it clone impl-b "$run" "$cli" --server "http://127.0.0.1:$port" clone "$dir/b-full"
    same_checkout "$dir/git-full" "$dir/b-full" ".$(basename "$cli")"
    time_it "sparse clone" impl-b "$run" "$cli" --server "http://127.0.0.1:$port" clone "$dir/b-sparse" --path "$SPARSE"
    same_checkout "$dir/git-sparse/$SPARSE" "$dir/b-sparse/$SPARSE" ".$(basename "$cli")"
    unsupported status impl-b "$run"
    unsupported log impl-b "$run"
    unsupported blame impl-b "$run"
    echo "// bench-real run $run" >>"$dir/b-sparse/$EDIT_FILE"
    # Its commit uploads, creates the changeset and moves main in one step.
    time_it land impl-b "$run" "$cli" commit -m 'bench edit' --dir "$dir/b-sparse"
    kill "$impl_b_pid" 2>/dev/null || true
    wait "$impl_b_pid" 2>/dev/null || true
}

machine() {
    local cpu mem
    if [ "$(uname -s)" = Darwin ]; then
        cpu=$(sysctl -n machdep.cpu.brand_string)
        mem=$(($(sysctl -n hw.memsize) / 1073741824))
    else
        cpu=$(sed -n 's/^model name[[:space:]]*: //p' /proc/cpuinfo | head -1)
        mem=$(($(sed -n 's/^MemTotal: *\([0-9]*\).*/\1/p' /proc/meminfo) / 1048576))
    fi
    echo "$(uname -srm); ${cpu:-unknown cpu}; $(getconf _NPROCESSORS_ONLN 2>/dev/null || sysctl -n hw.ncpu) cpus; ${mem} GiB"
}

mkdir -p "$WORK" "$(dirname "$OUT")"
[ -d "$SUBSET" ] || build_subset

say "starting Postgres and S3"
"${COMPOSE[@]}" up -d --wait >"$WORK/compose.log" 2>&1 || { cat "$WORK/compose.log" >&2; exit 1; }
say "building release binaries"
(cd "$ROOT" && cargo build -q --release -p scion-server -p scion-ingest -p scn)
IMPL_A=$WORK/impl-a-${IMPL_A_COMMIT:0:12}
IMPL_B=$WORK/impl-b-${IMPL_B_COMMIT:0:12}
if [ -n "$IMPL_A_URL" ]; then build_impl "$IMPL_A_URL" "$IMPL_A_COMMIT" "$IMPL_A"; setup_impl_a
else say "impl-a skipped: BENCH_IMPL_A_URL is not set"; fi
if [ -n "$IMPL_B_URL" ]; then build_impl "$IMPL_B_URL" "$IMPL_B_COMMIT" "$IMPL_B"
else say "impl-b skipped: BENCH_IMPL_B_URL is not set"; fi

port=$(( (RANDOM % 20000) + 30000 ))
SCION_LISTEN=127.0.0.1:$port "$BIN/scion-server" 2>"$WORK/server.log" &
server_pid=$!
impl_a_pid="" impl_b_pid=""
trap 'kill $server_pid $impl_a_pid $impl_b_pid 2>/dev/null || true; [ -z "$IMPL_A_URL" ] || docker rm -f "$CRDB" >/dev/null 2>&1 || true' EXIT
SERVER=http://127.0.0.1:$port
for _ in $(seq 1 50); do
    grep -q listening "$WORK/server.log" && break
    kill -0 $server_pid || { cat "$WORK/server.log" >&2; exit 1; }
    sleep 0.2
done

commits=$(git -C "$SUBSET" rev-list --count main)
files=$(git -C "$SUBSET" ls-tree -r main | wc -l | tr -d ' ')
{
    echo "# repository: $UPSTREAM $SUBDIR/, first-parent commits since $SINCE up to $TIP ($commits commits, $files files at the tip)"
    echo "# machine: $(machine)"
    echo "# tools: $(git --version); scion $(git -C "$ROOT" rev-parse --short HEAD); $RUNS runs; $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    [ -z "$IMPL_A_URL" ] || echo "# impl-a: $IMPL_A_URL $IMPL_A_COMMIT over CockroachDB ${CRDB_IMAGE#*:} + the same S3"
    [ -z "$IMPL_B_URL" ] || echo "# impl-b: $IMPL_B_URL $IMPL_B_COMMIT in memory"
    echo "workload,tool,run,ms,result"
} >"$OUT"

stamp=$(date +%s)
for run in $(seq 1 "$RUNS"); do
    say "run $run of $RUNS"
    dir=$WORK/run-$run
    repo=bench-$stamp-$run
    rm -rf "$dir"
    mkdir -p "$dir"
    git init -q --bare "$dir/origin.git"
    git -C "$dir/origin.git" config uploadpack.allowFilter true

    time_it import git "$run" git -C "$SUBSET" push -q "$dir/origin.git" main
    time_it import scion "$run" "$BIN/scion-ingest" import "$SUBSET" "$repo" main

    time_it clone git "$run" git clone -q --no-local "$dir/origin.git" "$dir/git-full"
    time_it clone scion "$run" "$BIN/scn" clone "$SERVER" "$repo" "$dir/scn-full"
    same_checkout "$dir/git-full" "$dir/scn-full"

    time_it "sparse clone" git "$run" sh -c "git clone -q --no-local --filter=blob:none --sparse \
        'file://$dir/origin.git' '$dir/git-sparse' && git -C '$dir/git-sparse' sparse-checkout set '$SPARSE'"
    time_it "sparse clone" scion "$run" "$BIN/scn" clone --sparse "$SPARSE" "$SERVER" "$repo" "$dir/scn-sparse"
    same_checkout "$dir/git-sparse/$SPARSE" "$dir/scn-sparse/$SPARSE"

    time_it status git "$run" git -C "$dir/git-full" status --porcelain
    time_it status scion "$run" sh -c "cd '$dir/scn-sparse' && '$BIN/scn' status"

    time_it log git "$run" git -C "$dir/git-full" log --first-parent -n 1000 -- "$LOG_PATH"
    time_it log scion "$run" sh -c "cd '$dir/scn-sparse' && '$BIN/scn' log -n 1000 '$LOG_PATH'"

    time_it blame git "$run" git -C "$dir/git-full" blame -- "$BLAME_FILE"
    time_it blame scion "$run" sh -c "cd '$dir/scn-sparse' && '$BIN/scn' blame '$BLAME_FILE'"

    # The other implementations compare their checkouts with git's, so they
    # run before git's land edits it.
    [ -z "$IMPL_A_URL" ] || impl_a_run "$run" "$dir"
    [ -z "$IMPL_B_URL" ] || impl_b_run "$run" "$dir"

    echo "// bench-real run $run" >>"$dir/git-full/$EDIT_FILE"
    echo "// bench-real run $run" >>"$dir/scn-sparse/$EDIT_FILE"
    time_it land git "$run" sh -c "git -C '$dir/git-full' commit -q -a -m 'bench edit' &&
        git -C '$dir/git-full' push -q origin HEAD:main"
    time_it land scion "$run" sh -c "cd '$dir/scn-sparse' && '$BIN/scn' commit -m 'bench edit' && '$BIN/scn' land"

    rm -rf "$dir"
done

say "wrote $OUT"
# Median per workload and tool, for a quick look; the CSV keeps every sample.
grep -v '^#' "$OUT" | tail -n +2 | sort -t, -k1,1 -k2,2 -k4,4n |
    awk -F, '$5 == "ok" { k = $1 "," $2; v[k, ++n[k]] = $4 }
             $5 == "failed" { failed[$1 "," $2]++ }
             $5 == "unsupported" { unsupported[$1 "," $2] = 1 }
             END {
                 for (k in n) print k "," v[k, int((n[k] + 1) / 2)] " ms"
                 for (k in failed) print k "," failed[k] " failed"
                 for (k in unsupported) print k ",unsupported"
             }' |
    sort | awk -F, '{ printf "%-14s %-6s %12s\n", $1, $2, $3 }' >&2
